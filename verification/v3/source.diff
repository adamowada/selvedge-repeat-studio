+  .tool-short { display: inline; }
+  .selection-tools { gap: var(--space-1); }
+  .selection-group + .selection-group { padding-left: var(--space-1); }
+  .selection-button { padding-left: var(--space-1); padding-right: var(--space-1); }
+  .selection-context { min-width: 56px; }
+  .no-selection > span { display: none; }
+}
+@media (max-width: 1250px) {
+  .document-toolbar { column-gap: var(--space-3); }
+  .color-value { display: none; }
+  .studio-layout { grid-template-columns: 200px minmax(0, 1fr) 224px; }
+}
+@media (max-width: 1080px) {
+  .studio-layout { grid-template-columns: 184px minmax(0, 1fr) 216px; }
+  .document-toolbar { display: grid; grid-template-columns: auto auto 1fr; }
+  .background-group { grid-column: 1 / 3; grid-row: 2; }
+  .view-tools { grid-column: 3; grid-row: 2; justify-self: end; }
+  .color-value { display: inline; }
+  .asset-thumbnail { width: 36px; height: 36px; }
+  .asset-place { display: none; }
+  .tile-diagram { width: 32px; }
+  .asset-section, .placement-section { padding: var(--space-3) var(--space-2); }
+  .source-note { font-size: 11px; }
+}
+@media (max-height: 760px) {
+  .output-sidebar section { padding-top: var(--space-3); padding-bottom: var(--space-3); }
+  .proof-container { width: min(100%, 192px); }
+  .asset-sidebar { grid-template-rows: minmax(208px, 1.15fr) minmax(148px, 1fr); }
